# Copy to .env (never committed) and adjust: cp .env.example .env

# Host port the app is published on.
KARAJOB_PORT=8080

# Host folder mounted as /data: SQLite database, migration backups, Data Protection keys.
# On Linux it must be writable by the container user: sudo chown 1654:1654 data
KARAJOB_DATA_DIR=./data

# Phase 2: CLAUDE_CODE_OAUTH_TOKEN=
