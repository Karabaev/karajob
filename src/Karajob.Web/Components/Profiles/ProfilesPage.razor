@page "/profiles"
@layout ProfileLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject UserService Users
@inject IDialogService DialogService

<PageTitle>Профили</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Кто вы?</MudText>

<div class="d-flex flex-wrap justify-center" style="gap:24px">
  @foreach (var profile in _profiles)
  {
    <div class="profile-tile d-flex flex-column align-center" style="width:140px">
      <ProfileSelectForm ProfileId="profile.Id" ReturnUrl="@ReturnUrl">
        <button type="submit" class="profile-select d-flex flex-column align-center"
                style="background:none; border:0; cursor:pointer; color:inherit; gap:8px">
          <ProfileAvatar Profile="profile" Size="Size.Large" />
          <MudText Typo="Typo.subtitle1">@profile.Name</MudText>
        </button>
      </ProfileSelectForm>
      <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" ButtonType="ButtonType.Button"
                     aria-label="@($"Изменить профиль {profile.Name}")"
                     OnClick="() => EditAsync(profile)" />
    </div>
  }
  <div class="d-flex flex-column align-center" style="width:140px">
    <button type="button" class="add-profile-tile d-flex flex-column align-center"
            style="background:none; border:0; cursor:pointer; color:inherit; gap:8px" @onclick="AddAsync">
      <MudAvatar Size="Size.Large" Variant="Variant.Outlined">+</MudAvatar>
      <MudText Typo="Typo.subtitle1">+ Профиль</MudText>
    </button>
  </div>
</div>

@code {
  private IReadOnlyList<UserDto> _profiles = [];

  [SupplyParameterFromQuery(Name = "returnUrl")]
  public string? ReturnUrl { get; set; }

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _profiles = await Users.ListAsync();
  }

  private Task AddAsync()
  {
    return ShowDialogAsync("Новый профиль", new DialogParameters<ProfileDialog>());
  }

  private Task EditAsync(UserDto profile)
  {
    return ShowDialogAsync("Изменить профиль", new DialogParameters<ProfileDialog> { { d => d.Profile, profile } });
  }

  private async Task ShowDialogAsync(string title, DialogParameters<ProfileDialog> parameters)
  {
    var dialog = await DialogService.ShowAsync<ProfileDialog>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    var result = await dialog.Result;
    if (result is { Canceled: false })
    {
      await LoadAsync();
    }
  }
}
