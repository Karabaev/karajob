<form method="post" action="@ProfileEndpoints.SelectPath" class="@Class">
  <AntiforgeryToken />
  <input type="hidden" name="@ProfileEndpoints.ProfileIdField" value="@ProfileId" />
  <input type="hidden" name="@ProfileEndpoints.ReturnUrlField" value="@(ReturnUrl ?? "/")" />
  @ChildContent
</form>

@code {
  [Parameter, EditorRequired]
  public Guid ProfileId { get; set; }

  [Parameter]
  public string? ReturnUrl { get; set; }

  [Parameter]
  public string? Class { get; set; }

  [Parameter]
  public RenderFragment? ChildContent { get; set; }
}
