<MudDialog>
  <DialogContent>
    <ProfileForm OnSaved="OnSaved" />
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">@L["Profile.Cancel"]</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  private void OnSaved(UserDto profile)
  {
    MudDialog.Close(DialogResult.Ok(profile));
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }
}
