@page "/vacancies/new"
@page "/vacancies/{Id:guid}"
@inject VacancyService VacancyService
@inject CompanyService CompanyService
@inject HypothesisService HypothesisService
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject InboxNotifier InboxNotifier
@inject UserDates Dates

<PageTitle>@Title</PageTitle>

@if (_notFound)
{
  <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Page.NotFound"]</MudText>
  <MudButton Href="/inbox">@L["Page.ToInbox"]</MudButton>
}
else if (_loaded)
{
  <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
    @if (_details is not null)
    {
      <MudChip T="string" Class="vacancy-stage" Size="Size.Small" Color="@VacancyText.StageColor(_details.Stage)">
        @VacancyText.Stage(_details.Stage)@(_details.DismissReason is { } reason ? $": {VacancyText.Dismiss(reason)}" : "")
      </MudChip>
      @if (_details.ReopenTarget is { } reopenTarget)
      {
        <MudButton Class="vacancy-reopen" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ReopenAsync(reopenTarget)">@L["Page.Reopen"]</MudButton>
      }
    }
  </MudStack>

  <MudGrid>
    <MudItem xs="12" md="7">
      <MudPaper Class="pa-4">
        <MudForm>
          <MudStack Spacing="2">
            @if (_errors.TryGetValue("", out var general))
            {
              <MudAlert Severity="Severity.Error">@general</MudAlert>
            }
            @if (_similar.Count > 0)
            {
              <MudAlert Class="vacancy-similar" Severity="Severity.Warning">
                <div>@L["Page.Similar"]</div>
                @foreach (var similar in _similar)
                {
                  <div>
                    <MudLink Href="@($"/vacancies/{similar.Id}")" Style="overflow-wrap: anywhere;">@similar.Url</MudLink>
                    <MudText Typo="Typo.caption" Inline="true">· @VacancyText.Stage(similar.Stage), @Dates.Format(similar.DiscoveredAt)</MudText>
                  </div>
                }
              </MudAlert>
            }

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
              <MudTextField T="string" Class="vacancy-title" Label="@L["Page.VacancyTitle"]"
                            MaxLength="Vacancy.TitleMaxLength" @bind-Value="_title" />
              <MudTooltip Text="@L["Page.FetchTitle"]">
                <MudIconButton Class="vacancy-fetch-title" Icon="@Icons.Material.Filled.Download" AriaLabel="@L["Page.FetchTitle"]"
                               Disabled="_fetchingTitle || _saving" OnClick="FetchTitleAsync" />
              </MudTooltip>
            </MudStack>

            <MudTextField T="string" Class="vacancy-url" Label="@L["Page.Url"]" Required="true" Immediate="true" spellcheck="false"
                          @bind-Value="_url"
                          Error="HasError(nameof(VacancyInput.Url))" ErrorText="@ErrorOf(nameof(VacancyInput.Url))" />

            <MudAutocomplete T="CompanyListItem" @key="_companyKey" Class="vacancy-company" Label="@L["Page.Company"]"
                             Value="_company" ValueChanged="OnCompanyChangedAsync"
                             SearchFunc="SearchCompaniesAsync" ToStringFunc="CompanyText"
                             Clearable="true" ResetValueOnEmptyText="true" DebounceInterval="200"
                             Error="HasError(nameof(VacancyInput.CompanyId))" ErrorText="@ErrorOf(nameof(VacancyInput.CompanyId))" />

            <MudSelect T="Guid?" Class="vacancy-role" Label="@L["Page.Role"]"
                       Value="_roleId" ValueChanged="OnRoleChangedAsync" ToStringFunc="RoleName"
                       HelperText="@EmptyHint(_roles)"
                       Error="HasError(nameof(VacancyInput.RoleId))" ErrorText="@ErrorOf(nameof(VacancyInput.RoleId))">
              <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["Page.NotSelected"]</MudSelectItem>
              @foreach (var role in _roles)
              {
                <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
              }
            </MudSelect>
            <MudSelect T="Guid?" Class="vacancy-location" Label="@L["Page.Location"]" @bind-Value="_locationId" ToStringFunc="LocationName"
                       HelperText="@EmptyHint(_locations)"
                       Error="HasError(nameof(VacancyInput.LocationId))" ErrorText="@ErrorOf(nameof(VacancyInput.LocationId))">
              <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["Page.NotSelected"]</MudSelectItem>
              @foreach (var location in _locations)
              {
                <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">@location.Name</MudSelectItem>
              }
            </MudSelect>
            <MudSelect T="Guid" Class="vacancy-platforms" Label="@L["Page.Platforms"]" MultiSelection="true"
                       SelectedValues="_platformIds" SelectedValuesChanged="OnPlatformsChanged"
                       ToStringFunc="PlatformName" MultiSelectionTextFunc="JoinNames"
                       HelperText="@EmptyHint(_platforms)"
                       Error="HasError(nameof(VacancyInput.PlatformIds))" ErrorText="@ErrorOf(nameof(VacancyInput.PlatformIds))">
              @foreach (var platform in _platforms)
              {
                <MudSelectItem T="Guid" Value="platform.Id">@platform.Name</MudSelectItem>
              }
            </MudSelect>
            <MudSelect T="Guid" Class="vacancy-engines" Label="@L["Page.Engines"]" MultiSelection="true"
                       SelectedValues="_engineIds" SelectedValuesChanged="OnEnginesChanged"
                       ToStringFunc="EngineName" MultiSelectionTextFunc="JoinNames"
                       HelperText="@EmptyHint(_engines)"
                       Error="HasError(nameof(VacancyInput.EngineIds))" ErrorText="@ErrorOf(nameof(VacancyInput.EngineIds))">
              @foreach (var engine in _engines)
              {
                <MudSelectItem T="Guid" Value="engine.Id">@engine.Name</MudSelectItem>
              }
            </MudSelect>
            <MudSelect T="Guid?" Class="vacancy-language" Label="@L["Page.Language"]" @bind-Value="_languageId" ToStringFunc="LanguageName"
                       HelperText="@EmptyHint(_languages)"
                       Error="HasError(nameof(VacancyInput.LanguageId))" ErrorText="@ErrorOf(nameof(VacancyInput.LanguageId))">
              <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["Page.NotSelectedLanguage"]</MudSelectItem>
              @foreach (var language in _languages)
              {
                <MudSelectItem T="Guid?" Value="@((Guid?)language.Id)">@language.Name</MudSelectItem>
              }
            </MudSelect>

            <div>
              <MudText Typo="Typo.subtitle2">@L["Page.WorkFormat"]</MudText>
              <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                <MudCheckBox T="bool" Class="vacancy-format-remote" Label="@L["Page.Remote"]"
                             Value="HasFormat(WorkFormat.Remote)" ValueChanged="value => SetFormat(WorkFormat.Remote, value)" />
                <MudCheckBox T="bool" Class="vacancy-format-hybrid" Label="@L["Page.Hybrid"]"
                             Value="HasFormat(WorkFormat.Hybrid)" ValueChanged="value => SetFormat(WorkFormat.Hybrid, value)" />
                <MudCheckBox T="bool" Class="vacancy-format-onsite" Label="@L["Page.OnSite"]"
                             Value="HasFormat(WorkFormat.OnSite)" ValueChanged="value => SetFormat(WorkFormat.OnSite, value)" />
                <MudCheckBox T="bool" Class="vacancy-format-relocation" Label="@L["Page.Relocation"]"
                             Value="HasFormat(WorkFormat.Relocation)" ValueChanged="value => SetFormat(WorkFormat.Relocation, value)" />
              </MudStack>
            </div>

            <div>
              <MudGrid Spacing="2">
                <MudItem xs="6" sm="4">
                  <MudNumericField T="long?" Class="vacancy-salary-min" Label="@L["Page.SalaryMin"]" HideSpinButtons="true"
                                   @bind-Value="_salaryMin" Error="HasError(SalaryKey)" />
                </MudItem>
                <MudItem xs="6" sm="4">
                  <MudNumericField T="long?" Class="vacancy-salary-max" Label="@L["Page.SalaryMax"]" HideSpinButtons="true"
                                   @bind-Value="_salaryMax" Error="HasError(SalaryKey)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                  <MudSelect T="string" Class="vacancy-salary-currency" Label="@L["Page.Currency"]" ToStringFunc="CurrencyCode" RelativeWidth="DropdownWidth.Adaptive" @bind-Value="_salaryCurrency"
                             Error="HasError(SalaryKey)">
                    @foreach (var currency in _currencies)
                    {
                      <MudSelectItem T="string" Value="currency.Code!">@currency.Code — @currency.Name</MudSelectItem>
                    }
                  </MudSelect>
                </MudItem>
              </MudGrid>
              @if (HasError(SalaryKey))
              {
                <MudText Typo="Typo.caption" Color="Color.Error">@ErrorOf(SalaryKey)</MudText>
              }
            </div>

            <MudSelect T="Guid" Class="vacancy-hypotheses" Label="@L["Page.Hypotheses"]" MultiSelection="true"
                       SelectedValues="_hypothesisIds" SelectedValuesChanged="OnHypothesesChanged"
                       ToStringFunc="HypothesisName" MultiSelectionTextFunc="JoinNames"
                       HelperText="@HypothesesHint()"
                       Error="HasError(nameof(VacancyInput.HypothesisIds))" ErrorText="@ErrorOf(nameof(VacancyInput.HypothesisIds))">
              @foreach (var hypothesis in VisibleHypotheses())
              {
                <MudSelectItem T="Guid" Value="hypothesis.Id">@hypothesis.Name</MudSelectItem>
              }
            </MudSelect>

            <MudTextField T="string" Class="vacancy-description" Label="@L["Page.Description"]" Lines="4" Sizing="InputSizing.Auto"
                          @bind-Value="_description" />
            <MudTextField T="string" Class="vacancy-notes" Label="@L["Page.Notes"]" Lines="3" Sizing="InputSizing.Auto"
                          @bind-Value="_notes" />

            <MudButton Class="vacancy-save" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || _fetchingTitle" OnClick="SaveAsync">@L["Common.Save"]</MudButton>
          </MudStack>
        </MudForm>
      </MudPaper>
    </MudItem>

    @if (_details is not null)
    {
      <MudItem xs="12" md="5">
        @if (_details.HasApplication)
        {
          <VacancyCoverLetter Text="@_details.CoverLetter" />
        }
        <VacancyTimeline Items="_details.Timeline" DiscoveredAt="_details.DiscoveredAt"
                         OnAdd="AddEventAsync" OnDelete="DeleteEventAsync" />
      </MudItem>
    }
  </MudGrid>
}

@code {
  private const string SalaryKey = "Salary";
  private const string DefaultCurrency = "RUB";

  private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
  private IReadOnlyList<CatalogListItem> _roles = [];
  private IReadOnlyList<CatalogListItem> _locations = [];
  private IReadOnlyList<CatalogListItem> _languages = [];
  private IReadOnlyList<CatalogListItem> _platforms = [];
  private IReadOnlyList<CatalogListItem> _engines = [];
  private IReadOnlyList<CatalogListItem> _currencies = [];
  private IReadOnlyList<HypothesisListItem> _hypotheses = [];
  private IReadOnlyList<SimilarVacancy> _similar = [];
  private VacancyDetails? _details;
  private Guid? _currentId;
  private bool _loaded;
  private bool _notFound;
  private bool _saving;
  private int _companyKey;
  private string? _companyQuery;
  private string? _url;
  private string? _title;
  private bool _fetchingTitle;
  private CompanyListItem? _company;
  private Guid? _roleId;
  private Guid? _locationId;
  private Guid? _languageId;
  private IReadOnlyCollection<Guid> _platformIds = [];
  private IReadOnlyCollection<Guid> _engineIds = [];
  private WorkFormat _format = WorkFormat.None;
  private long? _salaryMin;
  private long? _salaryMax;
  private string? _salaryCurrency;
  private IReadOnlyCollection<Guid> _hypothesisIds = [];
  private string? _description;
  private string? _notes;

  [Parameter]
  public Guid? Id { get; set; }

  private string Title => _details is not null ? L["Page.Title"].Value : Id is null ? L["Page.New"].Value : L["Page.NotFound"].Value;

  // The same component instance is reused when the route changes, so load here, not in OnInitialized.
  // After our own create the page already holds the saved vacancy, so the navigation to its id must not reload.
  protected override async Task OnParametersSetAsync()
  {
    if (_loaded && Id == _currentId) return;

    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _loaded = false;
    _errors = new Dictionary<string, string>();
    _notFound = false;
    _details = null;
    _currentId = Id;
    _roles = await CatalogService.ListAsync(CatalogKind.Role);
    _locations = await CatalogService.ListAsync(CatalogKind.Location);
    _languages = await CatalogService.ListAsync(CatalogKind.Language);
    _platforms = await CatalogService.ListAsync(CatalogKind.Platform);
    _engines = await CatalogService.ListAsync(CatalogKind.Engine);
    _currencies = await CatalogService.ListAsync(CatalogKind.Currency);

    if (Id is not null)
    {
      _details = await VacancyService.FindAsync(Id.Value);
      _notFound = _details is null;
    }

    var matched = _details?.HypothesisIds ?? [];
    var hypotheses = await HypothesisService.ListAsync();
    _hypotheses = hypotheses.Where(h => h.Status != HypothesisStatus.Disabled || matched.Contains(h.Id)).ToList();

    FillFields();
    _loaded = true;
  }

  private void FillFields()
  {
    _url = _details?.Url;
    _title = _details?.Title;
    _company = _details?.CompanyId is { } companyId
      ? new CompanyListItem(companyId, "", _details.CompanyName ?? "", null, [], false)
      : null;
    _companyKey++;
    _roleId = _details?.RoleId;
    _locationId = _details?.LocationId;
    _languageId = _details?.LanguageId;
    _platformIds = _details?.PlatformIds.ToList() ?? [];
    _engineIds = _details?.EngineIds.ToList() ?? [];
    _format = _details?.WorkFormat ?? WorkFormat.None;
    _salaryMin = _details?.SalaryMin;
    _salaryMax = _details?.SalaryMax;
    _salaryCurrency = _details?.SalaryCurrency ?? (_currencies.Any(c => c.Code == DefaultCurrency) ? DefaultCurrency : null);
    _hypothesisIds = _details?.HypothesisIds.ToList() ?? [];
    _description = _details?.Description;
    _notes = _details?.Notes;
    _similar = _details?.Similar ?? [];
  }

  private async Task<IEnumerable<CompanyListItem>> SearchCompaniesAsync(string? text, CancellationToken cancellationToken)
  {
    _companyQuery = text;
    var found = (await CompanyService.SearchAsync(text, cancellationToken)).ToList();
    var name = text?.Trim();
    if (!string.IsNullOrEmpty(name) && !found.Any(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase)))
    {
      found.Add(CreateEntry(name));
    }

    return found;
  }

  // The autocomplete has no "create new" slot when nothing matches, so the offer is a sentinel list entry with an empty id.
  private CompanyListItem CreateEntry(string name)
  {
    return new CompanyListItem(Guid.Empty, "", L["Page.CreateCompany", name].Value, null, [], false);
  }

  private static string CompanyText(CompanyListItem? company)
  {
    return company?.Name ?? "";
  }

  private async Task OnCompanyChangedAsync(CompanyListItem? company)
  {
    if (company is not null && company.Id == Guid.Empty)
    {
      var created = await CreateCompanyAsync();
      if (created is not null)
      {
        _company = created;
      }

      // Recreate the autocomplete so its text shows the actual selection instead of the "create" entry.
      _companyKey++;
    }
    else
    {
      _company = company;
    }

    await RefreshSimilarAsync();
  }

  private async Task<CompanyListItem?> CreateCompanyAsync()
  {
    var parameters = new DialogParameters<CreateCompanyDialog> { { d => d.InitialName, _companyQuery?.Trim() } };
    var reference = await DialogService.ShowAsync<CreateCompanyDialog>(L["Page.NewCompany"], parameters);
    var result = await reference.Result;
    if (result is not { Canceled: false, Data: CompanyDetails details })
    {
      return null;
    }

    return new CompanyListItem(details.Id, details.Slug, details.Name, details.IconUrl, details.Domains, details.IsBlacklisted);
  }

  private async Task OnRoleChangedAsync(Guid? roleId)
  {
    _roleId = roleId;
    await RefreshSimilarAsync();
  }

  private async Task RefreshSimilarAsync()
  {
    if (_company is null || _roleId is null)
    {
      _similar = [];
      return;
    }

    var companyId = _company.Id;
    var roleId = _roleId.Value;
    var similar = await VacancyService.FindSimilarAsync(companyId, roleId, _details?.Id);
    if (_company?.Id == companyId && _roleId == roleId)
    {
      _similar = similar;
    }
  }

  // Hypotheses of another role stay listed only while selected, so a role change can't silently drop a match;
  // the server rejects the save until the user deselects them.
  private IEnumerable<HypothesisListItem> VisibleHypotheses()
  {
    return _hypotheses.Where(h => _roleId is null || h.RoleId == _roleId || _hypothesisIds.Contains(h.Id));
  }

  private string? HypothesesHint()
  {
    if (_hypotheses.Count == 0)
    {
      return L["Page.NoHypotheses"];
    }

    return VisibleHypotheses().Any() ? null : L["Page.NoHypothesesForRole"].Value;
  }

  private void OnHypothesesChanged(IReadOnlyCollection<Guid>? hypothesisIds)
  {
    _hypothesisIds = hypothesisIds?.ToList() ?? [];
  }

  private string RoleName(Guid? id)
  {
    return _roles.FirstOrDefault(r => r.Id == id)?.Name ?? "";
  }

  private string LocationName(Guid? id)
  {
    return _locations.FirstOrDefault(l => l.Id == id)?.Name ?? "";
  }

  private void OnPlatformsChanged(IReadOnlyCollection<Guid>? platformIds)
  {
    _platformIds = platformIds?.ToList() ?? [];
  }

  private string PlatformName(Guid id)
  {
    return _platforms.FirstOrDefault(p => p.Id == id)?.Name ?? "";
  }

  private void OnEnginesChanged(IReadOnlyCollection<Guid>? engineIds)
  {
    _engineIds = engineIds?.ToList() ?? [];
  }

  private static string CurrencyCode(string? code)
  {
    return code ?? "";
  }

  private string EngineName(Guid id)
  {
    return _engines.FirstOrDefault(e => e.Id == id)?.Name ?? "";
  }

  private string LanguageName(Guid? id)
  {
    return _languages.FirstOrDefault(l => l.Id == id)?.Name ?? "";
  }

  private string HypothesisName(Guid id)
  {
    return _hypotheses.FirstOrDefault(h => h.Id == id)?.Name ?? "";
  }

  private static string JoinNames(IReadOnlyList<string?> names)
  {
    return string.Join(", ", names);
  }

  private string? EmptyHint(IReadOnlyList<CatalogListItem> items)
  {
    return items.Count == 0 ? L["Page.EmptyHint"].Value : null;
  }

  private bool HasFormat(WorkFormat flag)
  {
    return _format.HasFlag(flag);
  }

  private void SetFormat(WorkFormat flag, bool value)
  {
    _format = value ? _format | flag : _format & ~flag;
  }

  private bool HasError(string key)
  {
    return _errors.ContainsKey(key);
  }

  private string? ErrorOf(string key)
  {
    return _errors.GetValueOrDefault(key);
  }

  private async Task FetchTitleAsync()
  {
    if (_fetchingTitle) return;

    _fetchingTitle = true;
    try
    {
      var title = await VacancyService.FetchTitleAsync(_url ?? "");
      _errors = _errors.Where(e => e.Key != nameof(VacancyInput.Url)).ToDictionary();
      if (title is null)
      {
        Snackbar.Add(L["Page.TitleNotFound"], Severity.Warning);
        return;
      }

      _title = title;
    }
    catch (ValidationFailedException exception)
    {
      _errors = _errors.Where(e => e.Key != nameof(VacancyInput.Url)).Concat(exception.Errors).ToDictionary();
    }
    finally
    {
      _fetchingTitle = false;
    }
  }

  private async Task SaveAsync()
  {
    if (_saving) return;

    var hasSalary = _salaryMin is not null || _salaryMax is not null;
    var input = new VacancyInput(
      _url ?? "",
      _title,
      _company?.Id,
      _roleId,
      _locationId,
      _platformIds.ToList(),
      _engineIds.ToList(),
      _languageId,
      _format == WorkFormat.None ? null : _format,
      _salaryMin,
      _salaryMax,
      hasSalary ? _salaryCurrency : null,
      _hypothesisIds.ToList(),
      _description,
      _notes);

    _saving = true;
    try
    {
      VacancyDetails saved;
      if (_details is null)
      {
        saved = await VacancyService.CreateAsync(input);
        InboxNotifier.NotifyChanged();
      }
      else
      {
        saved = await VacancyService.UpdateAsync(_details.Id, input);
      }

      _errors = new Dictionary<string, string>();
      _details = saved;
      _currentId = saved.Id;
      FillFields();
      Snackbar.Add(L["Page.Saved"], Severity.Success);
      if (Id != saved.Id)
      {
        Navigation.NavigateTo($"/vacancies/{saved.Id}");
      }
    }
    catch (ValidationFailedException exception)
    {
      _errors = exception.Errors;
    }
    catch (KeyNotFoundException)
    {
      _notFound = true;
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task ReopenAsync(VacancyStage defaultTarget)
  {
    var parameters = new DialogParameters<ReopenVacancyDialog>
    {
      { d => d.VacancyId, _details!.Id },
      { d => d.DefaultTarget, defaultTarget },
    };
    var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
    var reference = await DialogService.ShowAsync<ReopenVacancyDialog>(L["Page.ReopenTitle"], parameters, options);
    var result = await reference.Result;
    if (result is { Canceled: false })
    {
      await LoadAsync();
    }
  }

  private async Task AddEventAsync()
  {
    var parameters = new DialogParameters<AddVacancyEventDialog>
    {
      { d => d.VacancyId, _details!.Id },
      { d => d.HasApplication, _details.ApplicationHypothesisId is not null },
      { d => d.DiscoveredAt, _details.DiscoveredAt },
    };
    var reference = await DialogService.ShowAsync<AddVacancyEventDialog>(L["Page.NewEvent"], parameters);
    var result = await reference.Result;
    if (result is { Canceled: false })
    {
      await ReloadTimelineAsync();
    }
  }

  private async Task DeleteEventAsync(TimelineItem item)
  {
    var confirmed = await DialogService.ShowMessageBoxAsync(
      L["Page.DeleteEventTitle"],
      L["Page.DeleteEventText", VacancyText.EventType(item.Type)].Value,
      yesText: L["Common.Delete"],
      cancelText: L["Common.Cancel"]);
    if (confirmed != true)
    {
      return;
    }

    try
    {
      await VacancyService.DeleteEventAsync(_details!.Id, item.Id);
      await ReloadTimelineAsync();
    }
    catch (ValidationFailedException exception)
    {
      Snackbar.Add(exception.Message, Severity.Error);
    }
    catch (KeyNotFoundException)
    {
      await ReloadTimelineAsync();
    }
  }

  // Only the timeline is refreshed so unsaved edits in the form survive.
  private async Task ReloadTimelineAsync()
  {
    var fresh = await VacancyService.FindAsync(_details!.Id);
    if (fresh is null)
    {
      _notFound = true;
      return;
    }

    _details = _details with { Timeline = fresh.Timeline };
  }
}
