<MudDialog DefaultFocus="DefaultFocus.None">
  <DialogContent>
    <QuickAddForm Completed="OnCompleted" Cancelled="OnCancelled" />
  </DialogContent>
</MudDialog>

@code {
  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  private void OnCompleted(QuickAddResult result)
  {
    MudDialog.Close(DialogResult.Ok(result.VacancyId));
  }

  private void OnCancelled()
  {
    MudDialog.Cancel();
  }
}
