@inject VacancyService VacancyService
@inject InboxNotifier InboxNotifier
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
  <DialogContent>
    <MudStack Spacing="2">
      <MudTextField T="string" Class="quick-add-url" Label="@L["AddVacancy.Url"]" Placeholder="https://…" AutoFocus="true"
                    InputType="InputType.Url" Immediate="true" @bind-Value="_url" @bind-Value:after="ClearUrlError" OnKeyDown="OnUrlKeyDown"
                    Error="_urlError is not null" ErrorText="@_urlError" />
      <MudTextField T="string" Class="quick-add-note" Label="@L["AddVacancy.Note"]" Lines="2" Sizing="InputSizing.Auto"
                    Immediate="true" @bind-Value="_note" />
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">@L["Common.Cancel"]</MudButton>
    <MudButton Class="quick-add-submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SubmitAsync">
      @L["Common.Add"]
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  private string? _url;
  private string? _note;
  private string? _urlError;
  private bool _saving;

  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  private void ClearUrlError()
  {
    _urlError = null;
  }

  private async Task OnUrlKeyDown(KeyboardEventArgs args)
  {
    if (args.Key != "Enter") return;

    await SubmitAsync();
  }

  private async Task SubmitAsync()
  {
    if (_saving) return;

    _saving = true;
    try
    {
      var result = await VacancyService.QuickAddAsync(new QuickAddInput(_url ?? string.Empty, _note));
      var cardUrl = $"/vacancies/{result.VacancyId}";
      MudDialog.Close(DialogResult.Ok(result.VacancyId));
      if (result.AlreadyExisted)
      {
        Snackbar.Add(L["AddVacancy.AlreadyExists", VacancyText.Stage(result.Stage)], Severity.Info);
        Navigation.NavigateTo(cardUrl);
        return;
      }

      InboxNotifier.NotifyChanged();
      Snackbar.Add(L["AddVacancy.Added"], Severity.Success, options =>
      {
        options.Action = L["AddVacancy.Open"];
        options.OnClick = _ =>
        {
          Navigation.NavigateTo(cardUrl);
          return Task.CompletedTask;
        };
      });
    }
    catch (ValidationFailedException ex)
    {
      _urlError = ex.Errors.GetValueOrDefault(nameof(QuickAddInput.Url)) ?? ex.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }
}
