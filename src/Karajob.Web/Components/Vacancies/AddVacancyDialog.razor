<MudDialog>
  <DialogContent>
    <MudText>Скоро здесь можно будет добавить вакансию по ссылке.</MudText>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Close">Закрыть</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  private void Close()
  {
    MudDialog.Close();
  }
}
