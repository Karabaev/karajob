@inject VacancyService VacancyService
@inject TrackService TrackService

<MudDialog>
  <DialogContent>
    @if (_tracks is null)
    {
      <MudProgressLinear Indeterminate="true" />
    }
    else
    {
      <MudStack Spacing="1">
        @if (_error is not null)
        {
          <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["MoveToBoard.Matching"]</MudText>
        @if (_tracks.Count == 0)
        {
          <MudText Class="move-to-board-empty">@L["MoveToBoard.NoTracks"]</MudText>
        }
        @foreach (var track in _tracks)
        {
          <MudCheckBox T="bool" Class="move-to-board-track" Color="Color.Primary"
                       Value="_selected.Contains(track.Id)" ValueChanged="checkedNow => Toggle(track.Id, checkedNow)">
            <MudStack Spacing="0">
              <MudText Typo="Typo.body1">@track.Name</MudText>
              <MudText Typo="Typo.caption" Class="mud-text-secondary">@TrackText.Summary(track)</MudText>
            </MudStack>
          </MudCheckBox>
        }
      </MudStack>
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">@L["Common.Cancel"]</MudButton>
    <MudButton Class="move-to-board-submit" Variant="Variant.Filled" Color="Color.Primary"
               Disabled="_saving || _selected.Count == 0" OnClick="SubmitAsync">
      @L["MoveToBoard.Submit"]
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  private IReadOnlyList<TrackListItem>? _tracks;
  private readonly HashSet<Guid> _selected = [];
  private string? _error;
  private bool _saving;

  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter, EditorRequired]
  public Guid VacancyId { get; set; }

  protected override async Task OnInitializedAsync()
  {
    var details = await VacancyService.FindAsync(VacancyId)
      ?? throw new KeyNotFoundException($"Vacancy {VacancyId} was not found.");
    _selected.UnionWith(details.TrackIds);
    var tracks = await TrackService.ListAsync();
    _tracks = tracks
      .Where(h => details.RoleId is null || h.RoleId == details.RoleId || _selected.Contains(h.Id))
      .Where(h => h.Status != TrackStatus.Disabled || _selected.Contains(h.Id))
      .ToList();
  }

  private void Toggle(Guid trackId, bool isChecked)
  {
    if (isChecked)
    {
      _selected.Add(trackId);
    }
    else
    {
      _selected.Remove(trackId);
    }
  }

  private async Task SubmitAsync()
  {
    if (_saving) return;

    _saving = true;
    try
    {
      await VacancyService.MoveToBoardAsync(VacancyId, _selected.ToList());
      MudDialog.Close(DialogResult.Ok(true));
    }
    catch (ValidationFailedException ex)
    {
      _error = ex.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }
}
