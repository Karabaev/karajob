@inject UserService Users
@inject ProfileCurrentUser CurrentUser
@inject NavigationManager Navigation
@implements IDisposable

@if (_current is not null)
{
  <MudMenu @bind-Open="_open" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent>
      <MudIconButton Class="profile-menu-button" Color="Color.Inherit" OnClick="ToggleMenu" aria-label="@L["Layout.Profile", _current.Name]">
        <ProfileAvatar Profile="_current" Class="profile-menu-avatar" />
      </MudIconButton>
    </ActivatorContent>
    <ChildContent>
      @foreach (var profile in _others)
      {
        <ProfileSelectForm ProfileId="profile.Id" ReturnUrl="@ReturnUrl()">
          <button type="submit" class="d-flex align-center px-4 py-2"
                  style="background:none; border:0; cursor:pointer; color:inherit; gap:12px; width:100%">
            <ProfileAvatar Profile="profile" Size="Size.Small" />
            <MudText>@profile.Name</MudText>
          </button>
        </ProfileSelectForm>
      }
      <MudDivider />
      <MudMenuItem Href="profile-settings" Icon="@Icons.Material.Filled.ManageAccounts">@L["Layout.ProfileSettings"]</MudMenuItem>
      <MudMenuItem Href="master-profile" Icon="@Icons.Material.Filled.Badge">@L["Layout.MasterProfile"]</MudMenuItem>
      <MudMenuItem Href="settings" Icon="@Icons.Material.Filled.Settings">@L["Layout.Settings"]</MudMenuItem>
      <MudMenuItem Href="@ProfileEndpoints.ProfilesPath" ForceLoad="true">@L["Layout.AllProfiles"]</MudMenuItem>
    </ChildContent>
  </MudMenu>
}

@code {
  private bool _open;
  private UserDto? _current;
  private IReadOnlyList<UserDto> _others = [];

  protected override async Task OnInitializedAsync()
  {
    CurrentUser.ProfileUpdated += OnProfileUpdated;
    await LoadAsync();
  }

  public void Dispose()
  {
    CurrentUser.ProfileUpdated -= OnProfileUpdated;
  }

  private async Task LoadAsync()
  {
    var profiles = await Users.ListAsync();
    _current = profiles.Single(p => p.Id == CurrentUser.UserId);
    _others = profiles.Where(p => p.Id != _current.Id).ToList();
  }

  private void OnProfileUpdated()
  {
    _ = InvokeAsync(async () =>
    {
      try
      {
        await LoadAsync();
        StateHasChanged();
      }
      catch (Exception ex)
      {
        await DispatchExceptionAsync(ex);
      }
    });
  }

  private void ToggleMenu()
  {
    _open = !_open;
  }

  private string ReturnUrl()
  {
    return "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
  }
}
