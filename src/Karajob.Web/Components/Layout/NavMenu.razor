@implements IDisposable
@inject VacancyService VacancyService
@inject InboxNotifier InboxNotifier

<MudNavMenu>
  <MudNavLink Href="inbox" Icon="@Icons.Material.Filled.Inbox">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
      <span>Inbox</span>
      @if (_inboxCount > 0)
      {
        <MudChip T="string" Class="inbox-count" Size="Size.Small" Color="Color.Primary">@_inboxCount</MudChip>
      }
    </MudStack>
  </MudNavLink>
  <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewKanban">@L["Layout.Board"]</MudNavLink>
  <MudNavLink Href="applications" Icon="@Icons.Material.Filled.History">@L["Layout.Applications"]</MudNavLink>
  <MudNavLink Href="companies" Icon="@Icons.Material.Filled.Business">@L["Layout.Companies"]</MudNavLink>
  <MudNavLink Href="tracks" Icon="@Icons.Material.Filled.Lightbulb">@L["Layout.Tracks"]</MudNavLink>
  <MudNavLink Href="weekly-review" Icon="@Icons.Material.Filled.EventNote">@L["Layout.WeeklyReview"]</MudNavLink>
  <MudNavLink Href="cvs" Icon="@Icons.Material.Filled.Description">CV</MudNavLink>
  <MudNavLink Href="catalogs" Icon="@Icons.Material.Filled.LibraryBooks">@L["Layout.Catalogs"]</MudNavLink>
  <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">@L["Layout.Settings"]</MudNavLink>
</MudNavMenu>

@code {
  private int _inboxCount;

  protected override async Task OnInitializedAsync()
  {
    InboxNotifier.Changed += OnInboxChanged;
    _inboxCount = await VacancyService.CountAsync(VacancyStage.Inbox);
  }

  private void OnInboxChanged()
  {
    _ = InvokeAsync(async () =>
    {
      try
      {
        _inboxCount = await VacancyService.CountAsync(VacancyStage.Inbox);
        StateHasChanged();
      }
      catch (Exception ex)
      {
        await DispatchExceptionAsync(ex);
      }
    });
  }

  public void Dispose()
  {
    InboxNotifier.Changed -= OnInboxChanged;
  }
}
