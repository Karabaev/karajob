@inject TrackDecisionService DecisionService
@inject ISnackbar Snackbar

<MudDialog>
  <DialogContent>
    @if (_review is null)
    {
      <MudProgressLinear Indeterminate="true" />
    }
    else
    {
      <MudStack Spacing="2">
        @if (_errors.TryGetValue("", out var general))
        {
          <MudAlert Severity="Severity.Error">@general</MudAlert>
        }
        <MudChip T="string" Class="decision-hint" Size="Size.Small" Color="@TrackText.HintColor(_review.Hint)"
                 data-hint="@_review.Hint">@TrackText.Hint(_review.Hint)</MudChip>
        @if (_review.Metrics.Conversion.IsInsufficientData)
        {
          <MudAlert Severity="Severity.Warning" Dense="true" Class="decision-insufficient">@L["Decision.InsufficientData"]</MudAlert>
        }
        <MudRadioGroup T="TrackDecisionKind" Class="decision-kind" Value="_kind" ValueChanged="OnKindChangedAsync">
          @foreach (var kind in Enum.GetValues<TrackDecisionKind>())
          {
            <MudRadio T="TrackDecisionKind" Value="kind">@TrackText.DecisionKind(kind)</MudRadio>
          }
        </MudRadioGroup>
        <MudTextField T="string" Class="decision-reason" Label="@L["Decision.Reason"]" Lines="2" Sizing="InputSizing.Auto"
                      Required="@(_kind == TrackDecisionKind.Disable)" @bind-Value="_reason"
                      ShrinkLabel="@(!string.IsNullOrEmpty(_reason))"
                      Error="HasError(nameof(DecisionInput.Reason))" ErrorText="@ErrorOf(nameof(DecisionInput.Reason))" />
        @if (_kind == TrackDecisionKind.Expand)
        {
          <MudTextField T="string" Class="decision-changes" Label="@L["Decision.Changes"]" Lines="3" Sizing="InputSizing.Auto"
                        Required="true" @bind-Value="_changes"
                        Error="HasError(nameof(DecisionInput.Changes))" ErrorText="@ErrorOf(nameof(DecisionInput.Changes))" />
        }
        @if (_kind == TrackDecisionKind.Disable && _options is not null)
        {
          @if (_options.Drafts.Count > 0)
          {
            <MudSelect T="Guid?" Class="decision-draft" Label="@L["Decision.ActivateDraft"]" @bind-Value="_draftId" ToStringFunc="DraftName"
                       Error="HasError(nameof(DecisionInput.ActivateDraftId))" ErrorText="@ErrorOf(nameof(DecisionInput.ActivateDraftId))">
              <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["Decision.NoDraft"]</MudSelectItem>
              @foreach (var draft in _options.Drafts)
              {
                <MudSelectItem T="Guid?" Value="@((Guid?)draft.Id)">@draft.Name</MudSelectItem>
              }
            </MudSelect>
          }

          var activeAfter = _options.ActiveCountAfter + (_draftId is null ? 0 : 1);
          var status = ActiveTracksRule.Check(activeAfter);
          if (status != ActiveTracksStatus.Ok)
          {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="decision-active-warning">
              @(status == ActiveTracksStatus.TooFew ? L["Decision.TooFew", activeAfter] : L["Decision.TooMany", activeAfter])
            </MudAlert>
          }
        }
      </MudStack>
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">@L["Track.Cancel"]</MudButton>
    <MudButton Class="decision-save" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_review is null || _saving)" OnClick="SaveAsync">@L["Decision.Save"]</MudButton>
  </DialogActions>
</MudDialog>

@code {
  private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
  private TrackReview? _review;
  private DisableOptions? _options;
  private TrackDecisionKind _kind = TrackDecisionKind.Continue;
  private string? _reason;
  private string? _changes;
  private Guid? _draftId;
  private bool _saving;

  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter, EditorRequired]
  public Guid TrackId { get; set; }

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _review = await DecisionService.GetReviewAsync(TrackId);
    }
    catch (KeyNotFoundException)
    {
      CloseAsGone();
    }
  }

  private async Task OnKindChangedAsync(TrackDecisionKind kind)
  {
    _kind = kind;
    string notPersonalFit = L["Decision.NotPersonalFit"];
    if (kind != TrackDecisionKind.Disable)
    {
      if (_reason == notPersonalFit)
      {
        _reason = null;
      }

      return;
    }

    if (_review?.Hint == DecisionHint.Disable && string.IsNullOrWhiteSpace(_reason))
    {
      _reason = notPersonalFit;
    }

    try
    {
      _options ??= await DecisionService.GetDisableOptionsAsync(TrackId);
    }
    catch (KeyNotFoundException)
    {
      CloseAsGone();
    }
  }

  // Deleted in another tab: an unhandled exception would drop the circuit; the page reloads and shows "not found".
  private void CloseAsGone()
  {
    Snackbar.Add(L["Track.NotFound"], Severity.Warning);
    MudDialog.Close(DialogResult.Ok(true));
  }

  private string DraftName(Guid? id)
  {
    return _options?.Drafts.FirstOrDefault(d => d.Id == id)?.Name ?? L["Decision.NoDraft"];
  }

  private bool HasError(string key)
  {
    return _errors.ContainsKey(key);
  }

  private string? ErrorOf(string key)
  {
    return _errors.GetValueOrDefault(key);
  }

  private async Task SaveAsync()
  {
    var input = new DecisionInput(
      _kind,
      _reason,
      _kind == TrackDecisionKind.Expand ? _changes : null,
      _kind == TrackDecisionKind.Disable ? _draftId : null);

    _saving = true;
    try
    {
      var result = await DecisionService.RecordDecisionAsync(TrackId, input);
      Snackbar.Add(L["Decision.Saved"], Severity.Success);
      if (_kind == TrackDecisionKind.Disable && result.ActiveStatus != ActiveTracksStatus.Ok)
      {
        Snackbar.Add(L["Decision.ActiveWarning"], Severity.Warning);
      }

      MudDialog.Close(DialogResult.Ok(true));
    }
    catch (ValidationFailedException exception)
    {
      _errors = exception.Errors;
    }
    catch (KeyNotFoundException)
    {
      CloseAsGone();
    }
    finally
    {
      _saving = false;
    }
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }
}
