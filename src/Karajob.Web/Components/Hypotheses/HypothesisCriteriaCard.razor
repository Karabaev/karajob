@using Karajob.Application.Metrics
@inject HypothesisMetricsService MetricsService
@inject HypothesisDecisionService DecisionService
@inject UserDates Dates

<MudPaper Class="pa-4 hypothesis-criteria">
  <MudText Typo="Typo.h6" HtmlTag="h2">@L["Hypothesis.Criteria"]</MudText>
  @if (_notFound)
  {
    <MudText Typo="Typo.body2" Class="mud-text-secondary criteria-unavailable">@L["Hypothesis.MetricsUnavailable"]</MudText>
  }
  else if (_review is null || (ShowActivity && _activity is null))
  {
    <MudProgressLinear Indeterminate="true" Class="mt-2" />
  }
  else
  {
    var metrics = _review.Metrics;
    var conversion = metrics.Conversion;
    var wellBeing = _review.WellBeing;
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
      @L["Hypothesis.WeekPeriod", MetricsText.Week(metrics.Week), Dates.FormatDate(metrics.PeriodStart)]
    </MudText>

    <MudStack Spacing="3" Class="mt-3">
      <div class="criteria-market">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
          <MudText Typo="Typo.subtitle2">@L["Hypothesis.Market"]</MudText>
          <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(metrics.Market.Verdict)">@MetricsText.Verdict(metrics.Market.Verdict)</MudChip>
        </MudStack>
        <MudText Typo="Typo.h5" Class="criteria-market-count">@metrics.Market.VacanciesThisWeek</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Hypothesis.MarketCaption", metrics.Market.ThresholdPerWeek]</MudText>
      </div>

      <MudDivider />

      <div class="criteria-conversion">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
          <MudText Typo="Typo.subtitle2">@L["Hypothesis.Conversion"]</MudText>
          <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(conversion.Verdict)">@MetricsText.Verdict(conversion.Verdict)</MudChip>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Baseline" Wrap="Wrap.Wrap" Spacing="2">
          <MudText Typo="Typo.h5">@(conversion.Rate is { } rate ? MetricsText.Percent(rate) : "—")</MudText>
          <MudText Typo="Typo.body1">@L["Hypothesis.OfCount", conversion.Positive, conversion.Matured]</MudText>
          @if (conversion.Interval is { } interval)
          {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Hypothesis.ConfidenceInterval", MetricsText.Interval(interval)]</MudText>
          }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
          @L["Hypothesis.ConversionCaption", MetricsText.ThresholdPercent(conversion.ThresholdPermille), conversion.MaturationDays]
        </MudText>
        @if (conversion.IsInsufficientData)
        {
          <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            @L["Hypothesis.MinSample", conversion.MinSampleSize]
          </MudText>
        }
      </div>

      <MudDivider />

      @if (_activity is not null)
      {
        <div class="criteria-activity">
          <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudText Typo="Typo.subtitle2">@L["Hypothesis.Activity"]</MudText>
            <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(_activity.Verdict)">@MetricsText.Verdict(_activity.Verdict)</MudChip>
          </MudStack>
          <MudText Typo="Typo.h5">@L["Hypothesis.OfCount", _activity.Applications, _activity.WeeklyTarget]</MudText>
          <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @L["Hypothesis.ActivityCaption", metrics.WeeklyApplications]
          </MudText>
        </div>

        <MudDivider />
      }

      <div class="criteria-wellbeing">
        <MudText Typo="Typo.subtitle2">@L["Hypothesis.WellBeing"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Baseline" Wrap="Wrap.Wrap" Spacing="2">
          <MudText Typo="Typo.h5">@(wellBeing.LatestTenths is { } latest ? MetricsText.Tenths(latest) : "—")</MudText>
          @if (wellBeing.TrendTenths is { } trend)
          {
            <MudText Typo="Typo.body2" Class="mud-text-secondary criteria-wellbeing-trend">@L["Hypothesis.WellBeingTrend", MetricsText.Trend(trend)]</MudText>
          }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Hypothesis.WellBeingCaption", _review.WellBeingThreshold]</MudText>
        @if (wellBeing.IsLow)
        {
          <MudAlert Severity="Severity.Warning" Dense="true" Class="criteria-wellbeing-low mt-1">@L["Hypothesis.WellBeingLow"]</MudAlert>
        }
      </div>

      <MudDivider />

      <div>
        <MudChip T="string" Class="criteria-hint" Size="Size.Small" Color="@HypothesisText.HintColor(_review.Hint)"
                 data-hint="@_review.Hint">@HypothesisText.Hint(_review.Hint)</MudChip>
      </div>
    </MudStack>
  }
</MudPaper>

@code {
  private HypothesisReview? _review;
  private ProfileActivity? _activity;
  private Guid? _loadedId;
  private int _loadedVersion;
  private bool _notFound;

  [Parameter, EditorRequired]
  public Guid HypothesisId { get; set; }

  [Parameter]
  public int Version { get; set; }

  [Parameter]
  public bool ShowActivity { get; set; } = true;

  // Every parent re-render sets parameters again; reload only when the hypothesis or the version actually changed.
  protected override async Task OnParametersSetAsync()
  {
    if (_loadedId == HypothesisId && _loadedVersion == Version) return;

    if (_loadedId != HypothesisId)
    {
      _review = null;
      _activity = null;
    }

    _notFound = false;
    _loadedId = HypothesisId;
    _loadedVersion = Version;
    var requestedId = HypothesisId;
    var requestedVersion = Version;
    try
    {
      var review = await DecisionService.GetReviewAsync(requestedId);
      var activity = ShowActivity ? await MetricsService.GetActivityAsync() : null;
      // A newer load may have started while this one awaited; only the latest result is shown.
      if (requestedId != _loadedId || requestedVersion != _loadedVersion) return;

      _review = review;
      _activity = activity;
    }
    catch (KeyNotFoundException)
    {
      // Deleted in another tab after the page loaded it: an unhandled exception here would drop the circuit and the unsaved form.
      _notFound = true;
    }
  }
}
