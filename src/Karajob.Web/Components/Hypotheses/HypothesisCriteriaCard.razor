@using Karajob.Application.Metrics
@inject HypothesisMetricsService MetricsService
@inject UserDates Dates

<MudPaper Class="pa-4 hypothesis-criteria">
  <MudText Typo="Typo.h6" HtmlTag="h2">@L["Hypothesis.Criteria"]</MudText>
  @if (_notFound)
  {
    <MudText Typo="Typo.body2" Class="mud-text-secondary criteria-unavailable">@L["Hypothesis.MetricsUnavailable"]</MudText>
  }
  else if (_metrics is null || _activity is null)
  {
    <MudProgressLinear Indeterminate="true" Class="mt-2" />
  }
  else
  {
    var conversion = _metrics.Conversion;
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
      @L["Hypothesis.WeekPeriod", MetricsText.Week(_metrics.Week), Dates.FormatDate(_metrics.PeriodStart)]
    </MudText>

    <MudStack Spacing="3" Class="mt-3">
      <div class="criteria-market">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
          <MudText Typo="Typo.subtitle2">@L["Hypothesis.Market"]</MudText>
          <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(_metrics.Market.Verdict)">@MetricsText.Verdict(_metrics.Market.Verdict)</MudChip>
        </MudStack>
        <MudText Typo="Typo.h5" Class="criteria-market-count">@_metrics.Market.VacanciesThisWeek</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Hypothesis.MarketCaption", _metrics.Market.ThresholdPerWeek]</MudText>
      </div>

      <MudDivider />

      <div class="criteria-conversion">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
          <MudText Typo="Typo.subtitle2">@L["Hypothesis.Conversion"]</MudText>
          <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(conversion.Verdict)">@MetricsText.Verdict(conversion.Verdict)</MudChip>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Baseline" Wrap="Wrap.Wrap" Spacing="2">
          <MudText Typo="Typo.h5">@(conversion.Rate is { } rate ? MetricsText.Percent(rate) : "—")</MudText>
          <MudText Typo="Typo.body1">@L["Hypothesis.OfCount", conversion.Positive, conversion.Matured]</MudText>
          @if (conversion.Interval is { } interval)
          {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Hypothesis.ConfidenceInterval", MetricsText.Interval(interval)]</MudText>
          }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
          @L["Hypothesis.ConversionCaption", MetricsText.ThresholdPercent(conversion.ThresholdPermille), conversion.MaturationDays]
        </MudText>
        @if (conversion.IsInsufficientData)
        {
          <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            @L["Hypothesis.MinSample", conversion.MinSampleSize]
          </MudText>
        }
      </div>

      <MudDivider />

      <div class="criteria-activity">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
          <MudText Typo="Typo.subtitle2">@L["Hypothesis.Activity"]</MudText>
          <MudChip T="string" Class="criteria-verdict" Size="Size.Small" Color="@MetricsText.VerdictColor(_activity.Verdict)">@MetricsText.Verdict(_activity.Verdict)</MudChip>
        </MudStack>
        <MudText Typo="Typo.h5">@L["Hypothesis.OfCount", _activity.Applications, _activity.WeeklyTarget]</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
          @L["Hypothesis.ActivityCaption", _metrics.WeeklyApplications]
        </MudText>
      </div>
    </MudStack>
  }
</MudPaper>

@code {
  private HypothesisMetrics? _metrics;
  private ProfileActivity? _activity;
  private Guid? _loadedId;
  private bool _notFound;

  [Parameter, EditorRequired]
  public Guid HypothesisId { get; set; }

  // Every parent re-render sets parameters again; reload only when the hypothesis actually changed.
  protected override async Task OnParametersSetAsync()
  {
    if (_loadedId == HypothesisId) return;

    _metrics = null;
    _activity = null;
    _notFound = false;
    _loadedId = HypothesisId;
    try
    {
      _metrics = await MetricsService.GetAsync(HypothesisId);
      _activity = await MetricsService.GetActivityAsync();
    }
    catch (KeyNotFoundException)
    {
      // Deleted in another tab after the page loaded it: an unhandled exception here would drop the circuit and the unsaved form.
      _notFound = true;
    }
  }
}
