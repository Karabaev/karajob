@page "/companies/new"
@page "/companies/{Slug}"
@inject CompanyService CompanyService
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<AppTitle Text="@Title" />

@if (_notFound)
{
  <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Page.NotFound"]</MudText>
  <MudButton Href="/companies">@L["Page.ToList"]</MudButton>
}
else if (_loaded)
{
  <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
    @if (_details is not null)
    {
      <CompanyIcon Name="@_details.Name" IconUrl="@_details.IconUrl" Size="Size.Large" />
    }
    <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
  </MudStack>

  <MudGrid>
    <MudItem xs="12" md="7">
      <MudPaper Class="pa-4">
        <MudForm>
          <MudStack Spacing="2">
            @if (_errors.TryGetValue("", out var general))
            {
              <MudAlert Severity="Severity.Error">@general</MudAlert>
            }
            <MudTextField T="string" Class="company-name" Label="@L["Page.Name"]" Required="true"
                          Immediate="true" Value="_name" ValueChanged="OnNameChanged"
                          Error="HasError(nameof(CompanyInput.Name))" ErrorText="@ErrorOf(nameof(CompanyInput.Name))" />
            <MudTextField T="string" Class="company-slug" Label="Slug" Required="true"
                          Immediate="true" Value="_slug" ValueChanged="OnSlugChanged" spellcheck="false"
                          Error="HasError(nameof(CompanyInput.Slug))" ErrorText="@ErrorOf(nameof(CompanyInput.Slug))" />
            <MudTextField T="string" Label="@L["Page.Website"]" @bind-Value="_website" spellcheck="false"
                          Error="HasError(nameof(CompanyInput.Website))" ErrorText="@ErrorOf(nameof(CompanyInput.Website))" />
            <MudTextField T="string" Label="@L["Page.Domains"]" HelperText="@L["Page.OnePerLine"]" Lines="3" Sizing="InputSizing.Auto"
                          @bind-Value="_domains" spellcheck="false"
                          Error="HasError(nameof(CompanyInput.Domains))" ErrorText="@ErrorOf(nameof(CompanyInput.Domains))" />
            <MudTextField T="string" Label="@L["Page.Aliases"]" HelperText="@L["Page.OnePerLine"]" Lines="3" Sizing="InputSizing.Auto"
                          @bind-Value="_aliases" spellcheck="false"
                          Error="HasError(nameof(CompanyInput.Aliases))" ErrorText="@ErrorOf(nameof(CompanyInput.Aliases))" />
            <MudSelect T="Guid" Class="company-locations" Label="@L["Page.Locations"]" MultiSelection="true"
                       SelectedValues="_locationIds" SelectedValuesChanged="OnLocationsChanged"
                       ToStringFunc="LocationName" MultiSelectionTextFunc="JoinNames"
                       HelperText="@(_locationOptions.Count == 0 ? L["Page.EmptyHint"].Value : null)"
                       Error="HasError(nameof(CompanyInput.LocationIds))" ErrorText="@ErrorOf(nameof(CompanyInput.LocationIds))">
              @foreach (var location in _locationOptions)
              {
                <MudSelectItem T="Guid" Value="location.Id">@location.Name</MudSelectItem>
              }
            </MudSelect>
            <MudTextField T="string" Label="@L["Page.Description"]" Lines="3" Sizing="InputSizing.Auto" @bind-Value="_description"
                          Error="HasError(nameof(CompanyInput.Description))" ErrorText="@ErrorOf(nameof(CompanyInput.Description))" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
              <MudButton Class="company-save" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">@L["Common.Save"]</MudButton>
              @if (_details is not null)
              {
                <MudButton Color="Color.Error" OnClick="DeleteAsync">@L["Page.DeleteCompany"]</MudButton>
              }
            </MudStack>
          </MudStack>
        </MudForm>
      </MudPaper>
    </MudItem>

    @if (_details is not null)
    {
      <MudItem xs="12" md="5">
        <MudStack Spacing="3">
          <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["Page.MyNote"]</MudText>
            <MudStack Spacing="2">
              <MudTextField T="string" Class="company-note" Label="@L["Page.Note"]" Lines="3" Sizing="InputSizing.Auto" @bind-Value="_note" />
              <MudSwitch T="bool" Label="@L["Page.Blacklist"]" Color="Color.Error" @bind-Value="_blacklisted" />
              <MudButton Class="note-save" Variant="Variant.Outlined" OnClick="SaveNoteAsync">@L["Page.SaveNote"]</MudButton>
            </MudStack>
          </MudPaper>

          <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
              <MudText Typo="Typo.h6">@L["Page.Projects"]</MudText>
              <MudButton Variant="Variant.Outlined" OnClick="() => OpenProjectDialogAsync(null)">@L["Page.AddProject"]</MudButton>
            </MudStack>
            @if (_details.Projects.Count == 0)
            {
              <MudText Class="mud-text-secondary">@L["Page.NoProjects"]</MudText>
            }
            else
            {
              <MudList T="ProjectItem" Dense="true">
                @foreach (var project in _details.Projects)
                {
                  var current = project;
                  <MudListItem T="ProjectItem">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                      <div>
                        @if (current.Url is null)
                        {
                          <MudText>@current.Name</MudText>
                        }
                        else
                        {
                          <MudLink Href="@current.Url" Target="_blank" Class="d-block">@current.Name</MudLink>
                        }
                        <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary">@ProjectSubtitle(current)</MudText>
                      </div>
                      <div>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Page.EditProject"]"
                                       OnClick="() => OpenProjectDialogAsync(current)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Page.DeleteProject"]"
                                       OnClick="() => DeleteProjectAsync(current)" />
                      </div>
                    </MudStack>
                  </MudListItem>
                }
              </MudList>
            }
          </MudPaper>
        </MudStack>
      </MudItem>
    }
  </MudGrid>
}

@code {
  private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
  private CompanyDetails? _details;
  private bool _loaded;
  private bool _notFound;
  private bool _slugEdited;
  private bool _saving;
  private string? _name;
  private string? _slug;
  private string? _website;
  private string? _description;
  private string? _domains;
  private string? _aliases;
  private IReadOnlyList<CatalogListItem> _locationOptions = [];
  private List<Guid> _locationIds = [];
  private string? _note;
  private bool _blacklisted;

  [Parameter]
  public string? Slug { get; set; }

  private string Title => _details?.Name ?? (Slug is null ? L["Page.New"].Value : L["Page.NotFound"].Value);

  // The same component instance is reused when the route changes, so load here, not in OnInitialized.
  // After our own save navigates to the saved slug the page already holds that company:
  // reloading would overwrite unsaved edits in the note card.
  protected override async Task OnParametersSetAsync()
  {
    if (_loaded && Slug is not null && Slug == _details?.Slug) return;

    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _errors = new Dictionary<string, string>();
    _notFound = false;
    _details = null;
    _locationOptions = await CatalogService.ListAsync(CatalogKind.Location);

    if (Slug is not null)
    {
      _details = await CompanyService.FindBySlugAsync(Slug);
      _notFound = _details is null;
    }

    FillCompanyFields();
    _note = _details?.Note;
    _blacklisted = _details?.IsBlacklisted ?? false;
    _loaded = true;
  }

  private void FillCompanyFields()
  {
    _slugEdited = _details is not null;
    _name = _details?.Name;
    _slug = _details?.Slug;
    _website = _details?.Website;
    _description = _details?.Description;
    _domains = _details is null ? null : string.Join('\n', _details.Domains);
    _aliases = _details is null ? null : string.Join('\n', _details.Aliases);
    _locationIds = _details?.LocationIds.ToList() ?? [];
  }

  private void OnLocationsChanged(IReadOnlyCollection<Guid>? locationIds)
  {
    _locationIds = locationIds?.ToList() ?? [];
  }

  private string LocationName(Guid id)
  {
    return _locationOptions.FirstOrDefault(l => l.Id == id)?.Name ?? "";
  }

  private static string JoinNames(IReadOnlyList<string?> names)
  {
    return string.Join(", ", names);
  }

  private async Task RefreshProjectsAsync()
  {
    var fresh = await CompanyService.FindBySlugAsync(_details!.Slug);
    _details = _details with { Projects = fresh!.Projects };
  }

  private void OnNameChanged(string? name)
  {
    _name = name;
    if (!_slugEdited)
    {
      _slug = Normalize.Slugify(name ?? "");
    }
  }

  private void OnSlugChanged(string? slug)
  {
    _slug = slug;
    _slugEdited = true;
  }

  private bool HasError(string key)
  {
    return _errors.ContainsKey(key);
  }

  private string? ErrorOf(string key)
  {
    return _errors.GetValueOrDefault(key);
  }

  private static IReadOnlyList<string> SplitLines(string? text)
  {
    return (text ?? "")
      .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
      .ToList();
  }

  private static string ProjectSubtitle(ProjectItem project)
  {
    var parts = new[] { project.Genre, project.EngineName, ProjectDialog.StatusText(project.Status) };
    return string.Join(" · ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
  }

  private async Task SaveAsync()
  {
    var input = new CompanyInput(
      _slug ?? "",
      _name ?? "",
      _website,
      _description,
      SplitLines(_domains),
      SplitLines(_aliases),
      _locationIds);

    _saving = true;
    try
    {
      var saved = _details is null
        ? await CompanyService.CreateAsync(input)
        : await CompanyService.UpdateAsync(_details.Id, input);

      _errors = new Dictionary<string, string>();
      _details = saved;
      FillCompanyFields();
      Snackbar.Add(L["Page.Saved"], Severity.Success);
      if (Slug != saved.Slug)
      {
        Navigation.NavigateTo($"/companies/{saved.Slug}");
      }
    }
    catch (ValidationFailedException exception)
    {
      _errors = exception.Errors;
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task DeleteAsync()
  {
    var confirmed = await DialogService.ShowMessageBoxAsync(
      L["Page.DeleteCompanyTitle"],
      L["Page.DeleteCompanyText", _details!.Name].Value,
      yesText: L["Common.Delete"],
      cancelText: L["Common.Cancel"]);
    if (confirmed != true)
    {
      return;
    }

    try
    {
      await CompanyService.DeleteAsync(_details.Id);
      Navigation.NavigateTo("/companies");
    }
    catch (ValidationFailedException exception)
    {
      Snackbar.Add(exception.Message, Severity.Error);
    }
  }

  private async Task SaveNoteAsync()
  {
    await CompanyService.SaveNoteAsync(_details!.Id, _note, _blacklisted);
    Snackbar.Add(L["Page.NoteSaved"], Severity.Success);
  }

  private async Task OpenProjectDialogAsync(ProjectItem? project)
  {
    var parameters = new DialogParameters<ProjectDialog>
    {
      { dialog => dialog.CompanyId, _details!.Id },
      { dialog => dialog.Item, project }
    };

    var reference = await DialogService.ShowAsync<ProjectDialog>(
      project is null ? L["Page.NewProject"].Value : L["Page.ProjectTitle"].Value,
      parameters,
      new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    var result = await reference.Result;
    if (result is { Canceled: false })
    {
      await RefreshProjectsAsync();
    }
  }

  private async Task DeleteProjectAsync(ProjectItem project)
  {
    var confirmed = await DialogService.ShowMessageBoxAsync(
      L["Page.DeleteProjectTitle"],
      L["Page.DeleteProjectText", project.Name].Value,
      yesText: L["Common.Delete"],
      cancelText: L["Common.Cancel"]);
    if (confirmed != true)
    {
      return;
    }

    await CompanyService.DeleteProjectAsync(project.Id);
    await RefreshProjectsAsync();
  }
}
