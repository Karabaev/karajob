@inject CatalogService CatalogService

<MudDialog>
  <DialogContent>
    <MudTextField T="string" Label="Название" @bind-Value="_name" Immediate="true" AutoFocus="true"
                  Error="@(_error is not null)" ErrorText="@_error" />
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Отмена</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Сохранить</MudButton>
  </DialogActions>
</MudDialog>

@code {
  private string _name = string.Empty;
  private string? _error;

  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter, EditorRequired]
  public CatalogKind Kind { get; set; }

  [Parameter, EditorRequired]
  public CatalogListItem Item { get; set; } = null!;

  protected override void OnInitialized()
  {
    _name = Item.Name;
  }

  private async Task SaveAsync()
  {
    try
    {
      await CatalogService.RenameAsync(Kind, Item.Id, _name);
    }
    catch (ValidationFailedException ex)
    {
      _error = string.Join(" ", ex.Errors.Values);
      return;
    }

    MudDialog.Close(DialogResult.Ok(true));
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }
}
