@inject CatalogService CatalogService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start" Spacing="2" Class="mb-4">
  <MudTextField T="string" Class="catalog-add-name" Label="@L["Catalog.Name"]" Immediate="true" @bind-Value="_name"
                Error="HasError(nameof(CatalogInput.Name))" ErrorText="@ErrorOf(nameof(CatalogInput.Name))" />
  @if (HasCode)
  {
    <MudTextField T="string" Class="catalog-add-code" Label="@L["Catalog.Code"]" Placeholder="@CodePlaceholder" Immediate="true" @bind-Value="_code"
                  Error="HasError(nameof(CatalogInput.Code))" ErrorText="@ErrorOf(nameof(CatalogInput.Code))" />
  }
  <MudButton Class="catalog-add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">@L["Catalog.Add"]</MudButton>
</MudStack>

<MudTable T="CatalogListItem" Items="_items" Breakpoint="Breakpoint.Sm" Dense="true" Hover="true"
          RowClass="catalog-row" Loading="_loading">
  <HeaderContent>
    <MudTh>@L["Catalog.Name"]</MudTh>
    @if (HasCode)
    {
      <MudTh>@L["Catalog.Code"]</MudTh>
    }
    @if (Kind == CatalogKind.Location)
    {
      <MudTh>@L["Catalog.TimeZone"]</MudTh>
    }
    <MudTh></MudTh>
  </HeaderContent>
  <RowTemplate>
    <MudTd DataLabel="@L["Catalog.Name"]"><span class="catalog-name">@context.Name</span></MudTd>
    @if (HasCode)
    {
      <MudTd DataLabel="@L["Catalog.Code"]">@context.Code</MudTd>
    }
    @if (Kind == CatalogKind.Location)
    {
      <MudTd DataLabel="@L["Catalog.TimeZone"]"><span class="catalog-time-zone-value">@context.TimeZoneId</span></MudTd>
    }
    <MudTd>
      <MudIconButton Class="catalog-rename" Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                     OnClick="() => RenameAsync(context)" aria-label="@L["Catalog.Rename"]" />
      <MudIconButton Class="catalog-delete" Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                     OnClick="() => DeleteAsync(context)" aria-label="@L["Catalog.Delete"]" />
    </MudTd>
  </RowTemplate>
</MudTable>

@code {
  private IReadOnlyList<CatalogListItem> _items = [];
  private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
  private string? _name;
  private string? _code;
  private bool _loading = true;

  [Parameter, EditorRequired]
  public CatalogKind Kind { get; set; }

  private bool HasCode => Kind is CatalogKind.Language or CatalogKind.Currency;

  private string CodePlaceholder => Kind == CatalogKind.Currency ? "RUB" : "ru";

  protected override async Task OnInitializedAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    _items = await CatalogService.ListAsync(Kind);
    _loading = false;
  }

  private bool HasError(string key)
  {
    return _errors.ContainsKey(key);
  }

  private string? ErrorOf(string key)
  {
    return _errors.GetValueOrDefault(key);
  }



  private async Task AddAsync()
  {
    try
    {
      await CatalogService.CreateAsync(Kind, new CatalogInput(_name ?? string.Empty, _code));
    }
    catch (ValidationFailedException ex)
    {
      _errors = ex.Errors;
      return;
    }

    _errors = new Dictionary<string, string>();
    _name = null;
    _code = null;
    await ReloadAsync();
  }

  private async Task RenameAsync(CatalogListItem item)
  {
    var parameters = new DialogParameters<RenameCatalogDialog>
    {
      { d => d.Kind, Kind },
      { d => d.Item, item },
    };
    var dialog = await DialogService.ShowAsync<RenameCatalogDialog>(L["Catalog.Rename"], parameters);
    var result = await dialog.Result;
    if (result is { Canceled: false })
    {
      await ReloadAsync();
    }
  }

  private async Task DeleteAsync(CatalogListItem item)
  {
    var confirmed = await DialogService.ShowMessageBoxAsync(
      L["Catalog.DeleteTitle"],
      L["Catalog.DeleteText", item.Name],
      yesText: L["Catalog.Delete"],
      cancelText: L["Catalog.Cancel"]);
    if (confirmed != true)
    {
      return;
    }

    try
    {
      await CatalogService.DeleteAsync(Kind, item.Id);
    }
    catch (ValidationFailedException ex)
    {
      Snackbar.Add(string.Join(" ", ex.Errors.Values), Severity.Error);
      return;
    }
    catch (KeyNotFoundException)
    {
    }

    await ReloadAsync();
  }
}
