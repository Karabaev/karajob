@page "/cvs"
@inject CvService CvService
@inject UserDates Dates

<AppTitle Text="@L["Pages.Cvs"]" />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
  <MudText Typo="Typo.h4" HtmlTag="h1">@L["Pages.Cvs"]</MudText>
  <MudButton Href="/cvs/new" Variant="Variant.Filled" Color="Color.Primary">+ CV</MudButton>
</MudStack>

@if (_items is null)
{
  <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
  <MudText Class="mud-text-secondary">@L["Pages.NoCvs"]</MudText>
}
else
{
  <MudTable Items="_items" Breakpoint="Breakpoint.Sm" Hover="true" Dense="true">
    <HeaderContent>
      <MudTh>@L["Pages.Name"]</MudTh>
      <MudTh>@L["Pages.Language"]</MudTh>
      <MudTh>@L["Pages.Tags"]</MudTh>
      <MudTh>@L["Pages.Versions"]</MudTh>
      <MudTh>@L["Pages.Updated"]</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="@L["Pages.Name"]"><MudLink Href="@($"/cvs/{context.Id}")">@context.Name</MudLink></MudTd>
      <MudTd DataLabel="@L["Pages.Language"]">@context.LanguageCode.ToUpperInvariant()</MudTd>
      <MudTd DataLabel="@L["Pages.Tags"]">
        @foreach (var tag in context.Tags)
        {
          <MudChip T="string" Size="Size.Small">@tag</MudChip>
        }
      </MudTd>
      <MudTd DataLabel="@L["Pages.Versions"]">@context.VersionCount</MudTd>
      <MudTd DataLabel="@L["Pages.Updated"]">@Dates.FormatDate(context.LatestVersionAt)</MudTd>
    </RowTemplate>
  </MudTable>
}

@code {
  private IReadOnlyList<CvListItem>? _items;

  protected override async Task OnInitializedAsync()
  {
    _items = await CvService.ListAsync();
  }
}
