@page "/catalogs"

<PageTitle>@L["Pages.Catalogs"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@L["Pages.Catalogs"]</MudText>

<MudTabs Rounded="true" Elevation="0" ApplyEffectsToContainer="true">
  <MudTabPanel Text="@L["Pages.Roles"]">
    <CatalogList Kind="CatalogKind.Role" />
  </MudTabPanel>
  <MudTabPanel Text="@L["Pages.Locations"]">
    <CatalogList Kind="CatalogKind.Location" />
  </MudTabPanel>
  <MudTabPanel Text="@L["Pages.Languages"]">
    <CatalogList Kind="CatalogKind.Language" />
  </MudTabPanel>
  <MudTabPanel Text="@L["Pages.Platforms"]">
    <CatalogList Kind="CatalogKind.Platform" />
  </MudTabPanel>
  <MudTabPanel Text="@L["Pages.Currencies"]">
    <CatalogList Kind="CatalogKind.Currency" />
  </MudTabPanel>
  <MudTabPanel Text="@L["Pages.Engines"]">
    <CatalogList Kind="CatalogKind.Engine" />
  </MudTabPanel>
</MudTabs>
