@page "/settings"
@inject SearchGoalService SearchGoalService
@inject CatalogService CatalogService
@inject ISnackbar Snackbar

<PageTitle>Настройки</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Настройки</MudText>

@if (_loaded)
{
  <MudGrid>
    <MudItem xs="12" md="7">
      <MudStack Spacing="4">
        <MudPaper Class="pa-4">
          <MudStack Spacing="2">
            <MudText Typo="Typo.h6" HtmlTag="h2">Цель поиска</MudText>
            @if (_errors.TryGetValue("", out var general))
            {
              <MudAlert Severity="Severity.Error">@general</MudAlert>
            }
            <MudSelect T="Guid?" Class="settings-role" Label="Роль" @bind-Value="_roleId" ToStringFunc="RoleName"
                       HelperText="@EmptyHint(_roles)"
                       Error="HasError(nameof(SearchGoalInput.RoleId))" ErrorText="@ErrorOf(nameof(SearchGoalInput.RoleId))">
              <MudSelectItem T="Guid?" Value="@((Guid?)null)">— не выбрана —</MudSelectItem>
              @foreach (var role in _roles)
              {
                <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
              }
            </MudSelect>
            <MudSelect T="Guid" Class="settings-locations" Label="Страны" MultiSelection="true"
                       SelectedValues="_locationIds" SelectedValuesChanged="OnLocationsChanged"
                       ToStringFunc="LocationName" MultiSelectionTextFunc="LocationsText"
                       HelperText="@EmptyHint(_locations)"
                       Error="HasError(nameof(SearchGoalInput.LocationIds))" ErrorText="@ErrorOf(nameof(SearchGoalInput.LocationIds))">
              @foreach (var location in _locations)
              {
                <MudSelectItem T="Guid" Value="location.Id">@location.Name</MudSelectItem>
              }
            </MudSelect>
            <MudTextField T="string" Class="settings-industries" Label="Индустрии" HelperText="по одной на строку"
                          Lines="3" Sizing="InputSizing.Auto" @bind-Value="_industries"
                          Error="HasError(nameof(SearchGoalInput.Industries))" ErrorText="@ErrorOf(nameof(SearchGoalInput.Industries))" />
            <MudTextField T="string" Class="settings-must-have" Label="Обязательные условия"
                          HelperText="Без чего вакансия не подходит"
                          Lines="3" Sizing="InputSizing.Auto" @bind-Value="_mustHave"
                          Error="HasError(nameof(SearchGoalInput.MustHave))" ErrorText="@ErrorOf(nameof(SearchGoalInput.MustHave))" />
            <MudNumericField T="int" Class="settings-weekly-target" Label="Откликов в неделю" Min="0"
                             @bind-Value="_weeklyTarget"
                             Error="HasError(nameof(SearchGoalInput.WeeklyApplicationTarget))" ErrorText="@ErrorOf(nameof(SearchGoalInput.WeeklyApplicationTarget))" />
            <MudDatePicker Class="settings-deadline" Label="Дедлайн поиска" Clearable="true" DateFormat="dd.MM.yyyy"
                           @bind-Date="_deadline"
                           Error="HasError(nameof(SearchGoalInput.Deadline))" ErrorText="@ErrorOf(nameof(SearchGoalInput.Deadline))" />
            <MudGrid Spacing="2">
              <MudItem xs="12" sm="8">
                <MudNumericField T="long?" Class="settings-income" Label="Желаемый доход в месяц (gross)" Min="0"
                                 @bind-Value="_income"
                                 Error="HasError(nameof(SearchGoalInput.DesiredMonthlyIncome))" ErrorText="@ErrorOf(nameof(SearchGoalInput.DesiredMonthlyIncome))" />
              </MudItem>
              <MudItem xs="12" sm="4">
                <MudTextField T="string" Class="settings-currency" Label="Валюта" Placeholder="RUB"
                              @bind-Value="_currency"
                              Error="HasError(nameof(SearchGoalInput.IncomeCurrency))" ErrorText="@ErrorOf(nameof(SearchGoalInput.IncomeCurrency))" />
              </MudItem>
            </MudGrid>
          </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4">
          <MudStack Spacing="2">
            <MudText Typo="Typo.h6" HtmlTag="h2">Пороги метрик</MudText>
            <MudNumericField T="int" Class="settings-market-threshold" Label="Рынок: вакансий в неделю"
                             HelperText="Сколько подходящих вакансий в неделю считается живым рынком"
                             @bind-Value="_marketThreshold"
                             Error="HasError(nameof(SearchGoalInput.MarketThresholdPerWeek))" ErrorText="@ErrorOf(nameof(SearchGoalInput.MarketThresholdPerWeek))" />
            <MudNumericField T="decimal" Class="settings-conversion-threshold" Label="Порог конверсии, %" Step="0.1m"
                             HelperText="Какая доля откликов с ответом считается хорошей"
                             @bind-Value="_conversionPercent"
                             Error="HasError(nameof(SearchGoalInput.ConversionThresholdPermille))" ErrorText="@ErrorOf(nameof(SearchGoalInput.ConversionThresholdPermille))" />
            <MudNumericField T="int" Class="settings-min-sample" Label="Минимальная выборка откликов"
                             HelperText="Пока откликов меньше, вывод по гипотезе делать рано"
                             @bind-Value="_minSample"
                             Error="HasError(nameof(SearchGoalInput.MinSampleSize))" ErrorText="@ErrorOf(nameof(SearchGoalInput.MinSampleSize))" />
            <MudNumericField T="int" Class="settings-maturation-days" Label="Созревание отклика, дней"
                             HelperText="Через сколько дней без ответа отклик считается созревшим"
                             @bind-Value="_maturationDays"
                             Error="HasError(nameof(SearchGoalInput.MaturationDays))" ErrorText="@ErrorOf(nameof(SearchGoalInput.MaturationDays))" />
          </MudStack>
        </MudPaper>

        <div>
          <MudButton Class="settings-save" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">Сохранить</MudButton>
        </div>
      </MudStack>
    </MudItem>
  </MudGrid>
}

@code {
  private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
  private IReadOnlyList<CatalogListItem> _roles = [];
  private IReadOnlyList<CatalogListItem> _locations = [];
  private bool _loaded;
  private bool _saving;
  private Guid? _roleId;
  private IReadOnlyCollection<Guid> _locationIds = [];
  private string? _industries;
  private string? _mustHave;
  private int _weeklyTarget;
  private DateTime? _deadline;
  private long? _income;
  private string? _currency;
  private int _marketThreshold;
  private decimal _conversionPercent;
  private int _minSample;
  private int _maturationDays;

  protected override async Task OnInitializedAsync()
  {
    _roles = await CatalogService.ListAsync(CatalogKind.Role);
    _locations = await CatalogService.ListAsync(CatalogKind.Location);
    FillFields(await SearchGoalService.GetAsync());
    _loaded = true;
  }

  private void FillFields(SearchGoalDetails goal)
  {
    _roleId = goal.RoleId;
    _locationIds = goal.LocationIds.ToList();
    _industries = goal.Industries;
    _mustHave = goal.MustHave;
    _weeklyTarget = goal.WeeklyApplicationTarget;
    _deadline = goal.Deadline?.ToDateTime(TimeOnly.MinValue);
    _income = goal.DesiredMonthlyIncome;
    _currency = goal.IncomeCurrency;
    _marketThreshold = goal.MarketThresholdPerWeek;
    _conversionPercent = ConversionPercent.FromPermille(goal.ConversionThresholdPermille);
    _minSample = goal.MinSampleSize;
    _maturationDays = goal.MaturationDays;
  }

  private void OnLocationsChanged(IReadOnlyCollection<Guid>? locationIds)
  {
    _locationIds = locationIds?.ToList() ?? [];
  }

  private string RoleName(Guid? id)
  {
    return _roles.FirstOrDefault(r => r.Id == id)?.Name ?? "";
  }

  private string LocationName(Guid id)
  {
    return _locations.FirstOrDefault(l => l.Id == id)?.Name ?? "";
  }

  private string LocationsText(IReadOnlyList<string?> names)
  {
    return string.Join(", ", names);
  }

  private static string? EmptyHint(IReadOnlyList<CatalogListItem> items)
  {
    return items.Count == 0 ? "Добавьте в разделе Справочники" : null;
  }

  private bool HasError(string key)
  {
    return _errors.ContainsKey(key);
  }

  private string? ErrorOf(string key)
  {
    return _errors.GetValueOrDefault(key);
  }

  private async Task SaveAsync()
  {
    var input = new SearchGoalInput(
      _roleId,
      _locationIds.ToList(),
      _industries,
      _mustHave,
      _weeklyTarget,
      _deadline is { } deadline ? DateOnly.FromDateTime(deadline) : null,
      _income,
      _income is null ? null : _currency,
      _marketThreshold,
      ConversionPercent.ToPermille(_conversionPercent),
      _minSample,
      _maturationDays);

    _saving = true;
    try
    {
      var saved = await SearchGoalService.UpdateAsync(input);
      _errors = new Dictionary<string, string>();
      FillFields(saved);
      Snackbar.Add("Сохранено", Severity.Success);
    }
    catch (ValidationFailedException exception)
    {
      _errors = exception.Errors;
    }
    finally
    {
      _saving = false;
    }
  }
}
