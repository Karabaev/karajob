<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Dockerfile restores before the .razor files are copied; without this the SDK heuristic skips
         Microsoft.AspNetCore.App.Internal.Assets (blazor.web.js) and the later publish without restore cannot add it. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karajob.Application\Karajob.Application.csproj" />
    <ProjectReference Include="..\Karajob.Infrastructure\Karajob.Infrastructure.csproj" />
    <ProjectReference Include="..\Karajob.Domain\Karajob.Domain.csproj" />
    <ProjectReference Include="..\Karajob.Migrations.Sqlite\Karajob.Migrations.Sqlite.csproj" />
  </ItemGroup>
</Project>
