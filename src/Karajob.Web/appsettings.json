{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    "DefaultCulture": "en"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/data/karajob.db"
  },
  "Backup": {
    "KeepDaily": 14
  },
  "Cv": {
    "MaxFileSizeMb": 5
  },
  "Transfer": {
    "MaxImportSizeMb": 200
  },
  "Files": {
    "RootDirectory": "/data/files"
  }
}
