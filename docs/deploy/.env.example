# Server config, saved as .env next to compose.yaml (never committed). See docs/deploy.md.

# Image tag to run, required: sha-<full commit sha> from GitHub -> Packages -> karajob.
# Change it to update, set the previous one back to roll back (see docs/deploy.md).
KARAJOB_TAG=

# Host port the app is published on.
KARAJOB_PORT=8080

# Host folder mounted as /data: SQLite database, migration backups, Data Protection keys.
# It must be writable by the container user: sudo chown 1654:1654 data
KARAJOB_DATA_DIR=./data
